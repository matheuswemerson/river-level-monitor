# Copie este arquivo para ".env" e preencha com os seus dados
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=tanque_db
PORT=3000

# (Opcional) Chave que o ESP32 envia no header "x-api-key" ao postar leituras.
# Use a mesma chave em firmware/esp32-sensor/secrets.h. Se ficar vazio, a rota fica aberta.
DEVICE_API_KEY=

# Segredo usado para assinar o token de login do admin. Use um texto longo e aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=
